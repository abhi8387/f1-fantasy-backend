generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  leaguesCreated   League[]       @relation("LeagueCreator")
  leagueMemberships LeagueMember[]
  fantasyTeam      FantasyTeam?

  @@map("users")
}

model League {
  id          Int      @id @default(autoincrement())
  name        String
  inviteCode  String   @unique @map("invite_code")
  createdById Int      @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User           @relation("LeagueCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   LeagueMember[]

  @@index([createdById])
  @@map("leagues")
}

model LeagueMember {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  leagueId Int      @map("league_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  @@unique([userId, leagueId])
  @@index([leagueId])
  @@map("league_members")
}

model Race {
  id            Int       @id @default(autoincrement())
  sessionKey    Int       @unique @map("session_key")
  meetingKey    Int?      @map("meeting_key")
  raceName      String    @map("race_name")
  location      String
  date          DateTime
  lineupOpensAt DateTime? @map("lineup_opens_at")
  isLocked      Boolean   @default(false) @map("is_locked")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  drivers Driver[]
  results RaceResult[]
  lineups Lineup[]

  @@index([date])
  @@map("races")
}

model Driver {
  id           Int      @id @default(autoincrement())
  driverNumber Int      @map("driver_number")
  fullName     String   @map("full_name")
  teamName     String   @map("team_name")
  sessionKey   Int      @map("session_key")
  price        Int      @default(10)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  race    Race         @relation(fields: [sessionKey], references: [sessionKey], onDelete: Cascade)
  results RaceResult[]
  picks   LineupPick[]

  @@unique([driverNumber, sessionKey])
  @@index([sessionKey])
  @@map("drivers")
}

model RaceResult {
  id       Int @id @default(autoincrement())
  raceId   Int @map("race_id")
  driverId Int @map("driver_id")
  position Int
  points   Int @default(0)

  race   Race   @relation(fields: [raceId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([raceId, driverId])
  @@map("race_results")
}

model FantasyTeam {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  budget    Int      @default(90)
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineups Lineup[]

  @@map("fantasy_teams")
}

model Lineup {
  id        Int      @id @default(autoincrement())
  teamId    Int      @map("team_id")
  raceId    Int      @map("race_id")
  createdAt DateTime @default(now()) @map("created_at")

  team  FantasyTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  race  Race         @relation(fields: [raceId], references: [id], onDelete: Cascade)
  picks LineupPick[]

  @@unique([teamId, raceId])
  @@map("lineups")
}

model LineupPick {
  id        Int     @id @default(autoincrement())
  lineupId  Int     @map("lineup_id")
  driverId  Int     @map("driver_id")
  isCaptain Boolean @default(false) @map("is_captain")

  lineup Lineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([lineupId, driverId])
  @@map("lineup_picks")
}
