NODE_ENV=development
PORT=3000

# Postgres (used directly by Prisma when running outside Docker)
DB_USER=f1admin
DB_PASSWORD=f1password
DB_NAME=f1_fantasy
DATABASE_URL=postgresql://f1admin:f1password@localhost:5433/f1_fantasy?schema=public
# Port 5433 avoids clashing with a native Postgres install that may already be using 5432

# Redis
REDIS_URL=redis://localhost:6379

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_64_char_random_secret_______________________
JWT_REFRESH_SECRET=replace_with_a_different_64_char_random_secret___________
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CORS_ORIGIN=*

OPENF1_BASE_URL=https://api.openf1.org/v1
